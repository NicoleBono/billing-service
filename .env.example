PORT=3000
NODE_ENV=production
APP_VERSION=1.0.0
DD_API_KEY=sua-api-key-do-datadog

DATABASE_URL=mongodb://usuario:senha@host:27017/billing

# Mercado Pago (sandbox) — https://www.mercadopago.com.br/developers
MP_ACCESS_TOKEN=TEST-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
MP_WEBHOOK_URL=https://<host>/billing/webhooks/mercadopago

# Saga (SNS/SQS) — ver repo infra-kubernetes/terraform/messaging.tf
AWS_REGION=us-east-1
SAGA_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:oficina-saga-events
SAGA_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/oficina-billing-service-saga-queue
# Opcional: aponta o SDK para o LocalStack em desenvolvimento local
AWS_ENDPOINT_URL=http://localhost:4566
